# Infomaniak OAuth2 credentials (from https://manager.infomaniak.com)
INFOMANIAK_CLIENT_ID=your_client_id
INFOMANIAK_CLIENT_SECRET=your_client_secret

# Comma-separated list of Infomaniak emails allowed to access admin panel
# Leave empty to allow any authenticated Infomaniak user
ADMIN_EMAILS=admin@example.com

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://1par1000.ch

# Node environment
NODE_ENV=production
